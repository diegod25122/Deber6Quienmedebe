# Copia este archivo como .env.local y pon los valores de tu proyecto de Supabase
# (Project Settings → API Keys). La publishable key es pública: viaja en la app.
# Nunca pongas aquí la secret key ni la service_role.
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
